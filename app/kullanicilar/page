"use client"

import { useEffect, useState } from "react"
import { useSession } from "next-auth/react"
import { useRouter } from "next/navigation"

export default function KullanicilarPage() {
  const { data: session, status } = useSession()
  const router = useRouter()
  const [kullanicilar, setKullanicilar] = useState([])
  const [form, setForm] = useState({ kullanici_adi: "", sifre: "", rol: "kasiyer" })
  const [yukleniyor, setYukleniyor] = useState(false)
  const [mesaj, setMesaj] = useState("")

  useEffect(() => {
    if (status === "unauthenticated") router.push("/giris")
    if (status === "authenticated" && session.user.rol !== "sahip") router.push("/pos")
  }, [status, session, router])

  useEffect(() => {
    if (status === "authenticated" && session.user.rol === "sahip") {
      kullanicilariGetir()
    }
  }, [status, session])

  async function kullanicilariGetir() {
    const res = await fetch("/api/kullanicilar")
    const data = await res.json()
    if (Array.isArray(data)) setKullanicilar(data)
  }

  async function kullaniciEkle() {
    if (!form.kullanici_adi || !form.sifre) return
    setYukleniyor(true)
    setMesaj("")

    const res = await fetch("/api/kullanicilar", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(form),
    })

    const data = await res.json()

    if (res.ok) {
      setForm({ kullanici_adi: "", sifre: "", rol: "kasiyer" })
      setMesaj("✓ Kullanıcı eklendi")
      await kullanicilariGetir()
    } else {
      setMesaj("✗ " + (data.hata || "Hata oluştu"))
    }

    setYukleniyor(false)
    setTimeout(() => setMesaj(""), 3000)
  }

  async function kullaniciSil(id) {
    if (!confirm("Bu kullanıcıyı silmek istediğine emin misin?")) return

    await fetch("/api/kullanicilar", {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id }),
    })

    await kullanicilariGetir()
  }

  if (status === "loading" || status === "unauthenticated") {
    return <div className="p-8 text-gray-500">Yükleniyor...</div>
  }

  return (
    <div className="p-8 max-w-2xl">
      <h1 className="text-2xl font-bold mb-6 text-gray-900 dark:text-gray-100">
        Kullanıcılar
      </h1>

      {/* Yeni kullanıcı formu */}
      <div className="border border-gray-200 dark:border-gray-700 rounded-xl p-5 mb-8 flex flex-col gap-3">
        <h2 className="font-medium text-gray-900 dark:text-gray-100">
          Yeni Kullanıcı Ekle
        </h2>
        <input
          className="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
          placeholder="Kullanıcı adı"
          value={form.kullanici_adi}
          onChange={(e) => setForm({ ...form, kullanici_adi: e.target.value })}
        />
        <input
          className="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
          placeholder="Şifre"
          type="password"
          value={form.sifre}
          onChange={(e) => setForm({ ...form, sifre: e.target.value })}
        />
        <select
          className="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100"
          value={form.rol}
          onChange={(e) => setForm({ ...form, rol: e.target.value })}
        >
          <option value="kasiyer">Kasiyer</option>
          <option value="sahip">Sahip</option>
        </select>

        {mesaj && (
          <p className={`text-sm font-medium ${mesaj.startsWith("✓") ? "text-green-600" : "text-red-500"}`}>
            {mesaj}
          </p>
        )}

        <button
          onClick={kullaniciEkle}
          disabled={yukleniyor}
          className="bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 rounded-lg p-3 font-medium hover:opacity-80 disabled:opacity-40 transition-opacity"
        >
          {yukleniyor ? "Ekleniyor..." : "Ekle"}
        </button>
      </div>

      {/* Kullanıcı listesi */}
      <div className="flex flex-col gap-2">
        {kullanicilar.map((k) => (
          <div
            key={k.id}
            className="border border-gray-200 dark:border-gray-700 rounded-xl p-4 flex justify-between items-center"
          >
            <div>
              <span className="font-medium text-gray-900 dark:text-gray-100">
                {k.kullanici_adi}
              </span>
              <span className={`text-xs ml-2 px-2 py-0.5 rounded-full ${
                k.rol === "sahip"
                  ? "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"
                  : "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400"
              }`}>
                {k.rol}
              </span>
            </div>
            {k.id !== session.user.id && (
              <button
                onClick={() => kullaniciSil(k.id)}
                className="text-sm text-red-500 hover:text-red-700 px-3 py-1 rounded-lg border border-red-200 hover:border-red-400 transition-colors"
              >
                Sil
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}